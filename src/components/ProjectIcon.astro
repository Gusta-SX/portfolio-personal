const { name } = Astro.props;
const inner = markup[name] ?? markup.layout;
---

<svg viewBox="0 0 24 24" aria-hidden="true" set:html={inner} />

<style>
  svg {
    width: 1.35rem;
    height: 1.35rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  svg :global(circle) {
    stroke: currentColor;
    fill: none;
  }
</style>
